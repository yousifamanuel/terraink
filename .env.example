APP_PORT=7200
VITE_UPDATES_URL=/updates.json
VITE_REPO_URL=https://github.com/USER/REPO
VITE_REPO_API_URL=https://api.github.com/repos/USER/REPO
VITE_CONTACT_EMAIL=hello@example.com
# Raw markdown URLs for the in-app legal modal (imprint + privacy).
VITE_LEGAL_NOTICE_URL=https://raw.githubusercontent.com/USER/META-REPO/main/imprint.md
VITE_PRIVACY_URL=https://raw.githubusercontent.com/USER/META-REPO/main/privacy.md
# Raw markdown URL for the mobile app's privacy policy, built as /privacy-app.
VITE_PRIVACY_APP_URL=https://raw.githubusercontent.com/USER/META-REPO/main/privacy_app.md
VITE_DEVELOPER_NAME=Your Name
VITE_DEVELOPER_PROFILE_URL=https://example.com/@your-profile

# Social media links (shown in the "Help Us Grow" panel section)
VITE_SOCIAL_LINKEDIN=https://linkedin.com/company/YOUR_PAGE
VITE_SOCIAL_INSTAGRAM=https://instagram.com/YOUR_HANDLE
VITE_SOCIAL_REDDIT=https://reddit.com/r/YOUR_SUBREDDIT
VITE_SOCIAL_THREADS=https://threads.net/@YOUR_HANDLE
VITE_SOCIAL_YOUTUBE=https://youtube.com/@YOUR_CHANNEL
VITE_KOFI_URL=https://ko-fi.com/YOUR_HANDLE

# Google Search Console verification token
VITE_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Google AdSense publisher ID for ads.txt — BARE form (e.g. pub-XXXXXXXXXXXXXXXX)
VITE_ADSENSE_PUBLISHER_ID=

# Google AdSense client ID for the loader script and ad units — ca-pub form
VITE_ADSENSE_AD_CLIENT=

# Sidebar ad unit in the poster preview panel. The slot is OFF unless enabled.
VITE_ADS_SIDEBAR_ENABLED=false
VITE_AD_SLOT_SIDEBAR=

# Canvas credits URL (shown bottom-left on the poster when Show Credits is enabled)
VITE_APP_CREDIT_URL=terraink.app
